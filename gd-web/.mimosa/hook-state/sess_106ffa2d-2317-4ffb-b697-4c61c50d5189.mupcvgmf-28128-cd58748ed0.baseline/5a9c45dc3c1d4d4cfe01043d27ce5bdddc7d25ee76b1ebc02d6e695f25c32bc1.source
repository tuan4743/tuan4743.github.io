/* 采音数据(自动生成,别手改)——来源:归档 tag lost-from-scratch 里旧版的 onset 检测输出,
 * 这里重新落成 TS 模块,好让 sim/ 在 Node 与浏览器里用同一份时间点(零依赖、零 IO)。
 *
 * 字段:
 *   bpm/period  —— 估计的节拍速度与一拍时长(秒);本曲 172 bpm,一拍 0.3483 秒
 *   offset      —— 第一拍相对 0 的位置(秒)
 *   duration    —— 全曲时长(秒),关卡长度由它决定
 *   beats[]     —— 检出的 onset(秒,严格递增)。铺面生成器【按这些时间点放障碍】,
 *                  于是障碍落在鼓点上,而不是"每 6 块放一个"。
 */
export interface BeatData {
  bpm: number;
  period: number;
  offset: number;
  duration: number;
  song: string;
  beats: number[];
}

